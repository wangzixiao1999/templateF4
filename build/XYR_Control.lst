 236:Core/Src/XYR_Control.c **** 	{
 237:Core/Src/XYR_Control.c **** 		if (AutoScanFlag)
 238:Core/Src/XYR_Control.c **** 		{
 239:Core/Src/XYR_Control.c **** 			for (size_t j = 0; j < y; j++)
 240:Core/Src/XYR_Control.c **** 			{
 241:Core/Src/XYR_Control.c **** 				if (AutoScanFlag)
 242:Core/Src/XYR_Control.c **** 				{
 243:Core/Src/XYR_Control.c **** 					XYR_ZDT_Fixed_Length_Move(2, i % 2, VOFA_Speed[1], VOFA_Pos[1]);
 244:Core/Src/XYR_Control.c **** 				}
 245:Core/Src/XYR_Control.c **** 				else
 246:Core/Src/XYR_Control.c **** 				{
 247:Core/Src/XYR_Control.c **** 					break;
 248:Core/Src/XYR_Control.c **** 				}
 249:Core/Src/XYR_Control.c **** 			}
 250:Core/Src/XYR_Control.c **** 			XYR_ZDT_Fixed_Length_Move(1, 0, VOFA_Speed[0], VOFA_Pos[0]);
 251:Core/Src/XYR_Control.c **** 		}
 252:Core/Src/XYR_Control.c **** 		else
 253:Core/Src/XYR_Control.c **** 		{
 254:Core/Src/XYR_Control.c **** 			break;
 255:Core/Src/XYR_Control.c **** 		}
 256:Core/Src/XYR_Control.c **** 	}
 257:Core/Src/XYR_Control.c **** }
