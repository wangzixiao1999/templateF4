  57:Core/Src/XYR_Control.c **** /**
  58:Core/Src/XYR_Control.c ****  * @brief    张大头定长移动
  59:Core/Src/XYR_Control.c ****  * @param    addr  	：电机地址
  60:Core/Src/XYR_Control.c ****  * @param    dir     ：方向								，0为归零方向，其余值为电机方向
  61:Core/Src/XYR_Control.c ****  * @param    velocity：最大速度(mm/s)					，范围0 - 250mm/s
  62:Core/Src/XYR_Control.c ****  * @param    position：位置(mm)							，范围0 - 118mm
  63:Core/Src/XYR_Control.c ****  */
  64:Core/Src/XYR_Control.c **** void XYR_ZDT_Fixed_Length_Move(uint8_t addr, uint8_t dir, float velocity, float position)
  65:Core/Src/XYR_Control.c **** {
  66:Core/Src/XYR_Control.c **** 	if (addr == 0 || addr > MAX_MOTORS - 1)
  67:Core/Src/XYR_Control.c **** 	{
  68:Core/Src/XYR_Control.c **** 		return; // 错误
  69:Core/Src/XYR_Control.c **** 	}
  70:Core/Src/XYR_Control.c **** 
  71:Core/Src/XYR_Control.c **** 	if (XYR_MotorState[addr - 1].state != XYRMOVE_IDLE)
  72:Core/Src/XYR_Control.c **** 	{
  73:Core/Src/XYR_Control.c **** 		return;
  74:Core/Src/XYR_Control.c **** 	}
  75:Core/Src/XYR_Control.c **** 
  76:Core/Src/XYR_Control.c **** 	if (velocity < 0.f)
  77:Core/Src/XYR_Control.c **** 		velocity = 0.f;
  78:Core/Src/XYR_Control.c **** 	else if (velocity > 250.f)
  79:Core/Src/XYR_Control.c **** 		velocity = 250.f;
  80:Core/Src/XYR_Control.c **** 
  81:Core/Src/XYR_Control.c **** 	if (position < 0.f)
  82:Core/Src/XYR_Control.c **** 		position = 0.f;
  83:Core/Src/XYR_Control.c **** 	else if (position > 118.f)
  84:Core/Src/XYR_Control.c **** 		position = 118.f;
  85:Core/Src/XYR_Control.c **** 
  86:Core/Src/XYR_Control.c **** 	XYR_MotorState_Transition(addr, XYRMOVE_WAIT_COMMEND);
  87:Core/Src/XYR_Control.c **** 	ZDT_X42_V2_Bypass_Position_LV_Control(addr, dir, velocity * 12, position * 72, 0, 0);
  88:Core/Src/XYR_Control.c **** }
