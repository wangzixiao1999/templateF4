 230:Core/Src/XYR_Control.c ****  */
 231:Core/Src/XYR_Control.c **** void XYR_AutoScan_Start(uint8_t x, uint8_t y)
 232:Core/Src/XYR_Control.c **** {
 233:Core/Src/XYR_Control.c **** 	AutoScanFlag = true;
 234:Core/Src/XYR_Control.c **** 
