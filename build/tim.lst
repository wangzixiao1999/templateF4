 216:Core/Src/tim.c **** /* update_pulse_generator: 需要被周期性调用（建议放到主循环或 SysTick/HAL_TIM 中�
 217:Core/Src/tim.c **** void update_pulse_generator(void) {
 218:Core/Src/tim.c ****   uint32_t now = __HAL_TIM_GET_COUNTER(&htim1);
 219:Core/Src/tim.c ****   system_ticks = now;
 220:Core/Src/tim.c **** 
 221:Core/Src/tim.c ****   uint8_t need_mask = 0;
 222:Core/Src/tim.c ****   uint32_t max_period = 0;
 223:Core/Src/tim.c **** 
 224:Core/Src/tim.c ****   /* 为了在 start_synchronized_pulse 返回后更新计数，我们先收集需要触发的通�
 225:Core/Src/tim.c ****   int need_indices[4];
 226:Core/Src/tim.c ****   int need_count = 0;
 227:Core/Src/tim.c **** 
 228:Core/Src/tim.c ****   for (int i = 0; i < 4; ++i) {
 229:Core/Src/tim.c ****     if (channels[i].active && channels[i].current_count < channels[i].count) {
 230:Core/Src/tim.c ****       /* 环形比较（考虑 16-bit 溢出） */
 231:Core/Src/tim.c ****       uint32_t next_time = channels[i].next_pulse_time;
 232:Core/Src/tim.c ****       uint32_t diff;
 233:Core/Src/tim.c **** 
 234:Core/Src/tim.c ****       if (now >= next_time) {
 235:Core/Src/tim.c ****         // 正常情况：当前时间 >= 下次触发时间
 236:Core/Src/tim.c ****         diff = now - next_time;
 237:Core/Src/tim.c ****       } else {
 238:Core/Src/tim.c ****         // 定时器溢出情况：当前时间 < 下次触发时间（由于计数器从0重新开
 239:Core/Src/tim.c ****         diff = (0xFFFF - next_time) + now + 1;
 240:Core/Src/tim.c ****       }
 241:Core/Src/tim.c **** 
 242:Core/Src/tim.c ****       if (diff < 0x8000u) {
 243:Core/Src/tim.c ****         need_mask |= (1u << i);
 244:Core/Src/tim.c ****         need_indices[need_count++] = i;
 245:Core/Src/tim.c ****         uint32_t p = channels[i].period_ticks;
 246:Core/Src/tim.c ****         if (p == 0) p = channels[i].width_ticks;
 247:Core/Src/tim.c ****         if (p > max_period) max_period = p;
 248:Core/Src/tim.c ****         /* 注意：不在这里更新 current_count/next_pulse_time，等待脉冲完成后再更�
 249:Core/Src/tim.c ****       }
ARM GAS  C:\Users\81506\AppData\Local\Temp\ccZgTQEt.s 			page 21


 250:Core/Src/tim.c ****     }
 251:Core/Src/tim.c ****   }
 252:Core/Src/tim.c **** 
 253:Core/Src/tim.c ****   if (need_mask == 0) return;
 254:Core/Src/tim.c **** 
 255:Core/Src/tim.c ****   if (max_period == 0) max_period = 1;
 256:Core/Src/tim.c ****   if (max_period > 0xFFFFu) max_period = 0xFFFFu;
 257:Core/Src/tim.c **** 
 258:Core/Src/tim.c ****   /* 启动同步单次脉冲，函数会阻塞直到该脉冲完成 */
 259:Core/Src/tim.c ****   start_synchronized_pulse(max_period, need_mask);
 260:Core/Src/tim.c **** 
 261:Core/Src/tim.c ****   /* 脉冲完成后，用定时器当前 CNT 作为新的基准来更新 next_pulse_time */
 262:Core/Src/tim.c ****   uint32_t end_now = __HAL_TIM_GET_COUNTER(&htim1);
 263:Core/Src/tim.c ****   system_ticks = end_now;
 264:Core/Src/tim.c **** 
 265:Core/Src/tim.c ****   for (int k = 0; k < need_count; ++k) {
 266:Core/Src/tim.c ****     int i = need_indices[k];
 267:Core/Src/tim.c ****     channels[i].current_count++;
 268:Core/Src/tim.c ****     channels[i].next_pulse_time = end_now + channels[i].period_ticks;
 269:Core/Src/tim.c ****     if (channels[i].next_pulse_time > 0xFFFF) {
 270:Core/Src/tim.c ****       channels[i].next_pulse_time &= 0xFFFF;
 271:Core/Src/tim.c ****     }
 272:Core/Src/tim.c ****     if (channels[i].current_count >= channels[i].count) {
 273:Core/Src/tim.c ****       channels[i].active = 0;
 274:Core/Src/tim.c ****     }
 275:Core/Src/tim.c ****   }
 276:Core/Src/tim.c **** }
